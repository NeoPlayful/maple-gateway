# Maple Gateway 环境变量示例。复制为 .env 使用（.env 不提交）。
# 由 main.go godotenv.Load() 从 cwd 自动加载。

# 监听端口（开发 e2e：mgmt 8090 / 数据面 8091 / HTTPS 8093 预留）
MAPLE_GATEWAY_HTTP_ADDR=:8091
MAPLE_MANAGEMENT_ADDR=:8090
# HTTPS 数据面预留端口（默认不启用，启用需同时提供证书与密钥）
# MAPLE_GATEWAY_HTTPS_ADDR=:8093

# 数据库（主力开发库）
MAPLE_DATABASE_URL=postgres://maple:maple@localhost:5432/maple?sslmode=disable

# Redis（同栈容器已启用）
MAPLE_REDIS_ENABLED=true
MAPLE_REDIS_URL=redis://localhost:6379
MAPLE_REDIS_PREFIX=maple

# Management API Bearer Token
MAPLE_ADMIN_TOKEN=dev-admin-token

# Internal API Token（Container Manager / Node Agent 状态上报）
MAPLE_INTERNAL_TOKEN=dev-internal-token

# 默认管理员（seed 使用）
MAPLE_ADMIN_EMAIL=admin@maple.com
MAPLE_ADMIN_PASSWORD=admin123

# 日志
MAPLE_LOG_LEVEL=info

# ---- Phase 4：多实例 HA / 分布式限流 / 自动 Canary / OTel ----
# 多实例 HA：true 时本进程注册 gateway_instances 并参与 Leader 竞逐（Redis 锁优先，DB lease 兜底）
MAPLE_HA_ENABLED=false
# MAPLE_HA_INSTANCE_ID=gw-a

# 分布式限流后端：memory（默认单机）/ redis（跨实例共享配额）
# MAPLE_RATE_LIMIT_MODE=redis

# 自动 Canary：指标驱动自动推进/回滚（默认关）
MAPLE_CANARY_AUTO_ENABLED=false
# MAPLE_CANARY_AUTO_ERR_RATE_MAX=5

# OTel 数据面追踪（默认关；开启后 span 导出到 stdout）
MAPLE_TRACE_ENABLED=false
# MAPLE_TRACE_SAMPLE_RATIO=0.01

# ---- Phase 5：Direct TLS ----
# 数据面证书选择模式：direct（按 SNI 动态选每域名证书，需 DB + 证书服务）/ global（单全局证书）。
# 与 config.yaml 的 tls.mode 对齐；默认 direct，未显式配置时也按 direct 处理。
MAPLE_TLS_MODE=direct
# 证书存储加密密钥：上传的域名证书私钥落库前用 AES-256-GCM 加密，密钥必须独立于数据库保管。
# 生成：openssl rand -base64 32
# 优先级低于 config 的 tls.cert_enc_key；两者都不配时证书管理 API 不注册（私钥绝不明文落库）。
# 注意：一旦用某把密钥加密过证书，更换密钥将无法解密存量私钥，需保持同一把。
# 下方为开发用固定密钥（本地直用）；生产必须更换并妥善保管。
MAPLE_TLS_CERT_ENC_KEY=u+IBv5z9z+RqwIbEV9WPfedoJLm/gj0MwM6QmF1+MYs=


