# Maple Gateway 环境变量示例。复制为 .env 使用（.env 不提交）。

# 数据库
MAPLE_DATABASE_URL=postgres://maple:maple@localhost:5432/maple?sslmode=disable

# Redis（Phase 1 默认关闭）
MAPLE_REDIS_URL=redis://localhost:6379/0

# 管理员认证
MAPLE_ADMIN_EMAIL=admin@maple.local
MAPLE_ADMIN_PASSWORD=admin123
# Management API Bearer Token（S5 起使用）
MAPLE_ADMIN_TOKEN=dev-admin-token

# 监听端口覆盖（本地开发避免 80/443 提权）
MAPLE_GATEWAY_HTTP_ADDR=:8000
MAPLE_MANAGEMENT_ADDR=:4000

# 日志
MAPLE_LOG_LEVEL=info
